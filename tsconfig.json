{
  "compilerOptions": {
    "lib": ["dom", "es2022"],
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "node",
    "jsx": "react",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["webpack-env", "node"],
    "allowJs": true,
    "checkJs": true
  },
  "include": ["src", "packages", "server", "config", "scripts"],
  "exclude": [
    "node_modules",
    "dist",
    "**/dist/**",
    ".nano-work",
    ".brojs",
    ".test-dist"
  ]
}
